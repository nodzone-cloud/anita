        "kyllä",
        "joo",
        "toimii",
        "onnistui"
      ],
      "no": [
        "нет",
        "неа",
        "не получилось",
        "не работает",
        "no",
        "nope",
        "didn't work",
        "doesn't work",
        "ei",
        "ei toimi",
        "ei onnistunut"
      ],
      "unknown": [
        "не знаю",
        "без понятия",
        "не уверен",
