{
  "meta": {
    "name": "ANITA Semantic Intent Layer",
    "version": "1.0.0",
    "project": "ANITA — Alex Node IT Assistant",
    "purpose": "Data layer for intent recognition, semantic normalization, context continuity, short-reply handling and routing into ANITA diagnostic workflows.",
    "languages": [
      "ru",
      "en",
      "fi"
    ],
    "important": [
      "This file contains data and rules, not executable logic.",
      "ANITA JavaScript must load this file and use its mappings.",
      "Exact phrase matching is only one signal; combine intent, entities, topic and dialogue context."
    ]
  },
  "normalization": {
    "lowercase": true,
    "trim": true,
    "collapse_whitespace": true,
    "keep_numbers": true,
    "avoid_partial_word_matching": true,
    "preserve_distinct_tokens": [
      "low",
      "slow",
      "0",
      "zeroaccess",
      "zero access"
    ],
    "replace": {
      "ru": {
        "комп": "computer",
        "компик": "computer",
        "пк": "computer",
        "ноут": "laptop",
        "ноутик": "laptop",
        "инет": "internet",
        "вайфай": "wifi",
        "тормозит": "slow",
        "тупит": "slow",
        "лагает": "slow",
        "зависает": "freeze"
      },
      "en": {
        "pc": "computer",
        "desktop": "computer",
        "rig": "computer",
        "lappy": "laptop",
        "net": "internet",
        "wi-fi": "wifi",
        "laggy": "slow",
        "sluggish": "slow",
        "freezes": "freeze",
        "crashes": "crash"
      },
      "fi": {
        "kone": "computer",
        "läppäri": "laptop",
        "netti": "internet",
        "wlan": "wifi",
        "lagaa": "slow",
        "hidas": "slow",
        "jumittaa": "freeze"
      }
    }
  },
